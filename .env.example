# Server Configuration
PORT=5000
HOST=0.0.0.0

# Official SIH Source URL
SIH_SOURCE_URL=https://www.sih.gov.in/sih2026PS

# Cache duration in seconds (300 = 5 minutes)
CACHE_TTL_SECONDS=300

# Scraper timeout in seconds
SCRAPE_TIMEOUT_SECONDS=20

# CORS Origin (* for all, or specify frontend domain e.g. https://your-frontend.com)
CORS_ORIGIN=*
